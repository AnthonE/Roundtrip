# Copy to server/.env and edit. Read by systemd (EnvironmentFile) and by `npm start`.

PORT=8787
HOST=127.0.0.1

# redis = Redis + MongoDB (production). memory = no databases, data lost on restart (local dev).
STORE=redis

# Redis 6.2+ (needs ZADD GT). All keys are prefixed rt: — a spare DB index keeps them apart
# from your other site's keys. With a password: redis://:PASSWORD@127.0.0.1:6379/2
REDIS_URL=redis://127.0.0.1:6379/2

# MongoDB 4.2+. With auth: mongodb://USER:PASS@127.0.0.1:27017/?authSource=admin
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=roundtrip

# nginx sets X-Real-IP; trust it so rate limits see the player's IP, not nginx's.
TRUST_PROXY=1

# Your subdomain with scheme. POSTs from any other site are refused.
ALLOWED_ORIGIN=https://roundtrip.example.com

# Any random string. IPs are only ever stored as salted hashes.
IP_SALT=change-me-to-something-random

# Per-IP, per-minute limits (nginx also limits /api/ to 10 req/s).
# LIMIT_RUNS=30
# LIMIT_WRITES=60
# LIMIT_READS=240

# Serve public/ from Node as well (only for running without nginx).
# DEV_STATIC=1
